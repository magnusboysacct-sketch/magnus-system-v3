{
  "rewrites": [
    {
      "source": "/api/share-card/:kind/:token/:v.png",
      "destination": "/api/share-card?k=:kind&t=:token&v=:v"
    },
    {
      "source": "/portal/contact/:token",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|Slackbot|TelegramBot|LinkedInBot|Discordbot|SkypeUriPreview|Googlebot).*"
        }
      ],
      "destination": "/api/share-preview?kind=contact&token=:token"
    },
    {
      "source": "/portal/:token",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|Slackbot|TelegramBot|LinkedInBot|Discordbot|SkypeUriPreview|Googlebot).*"
        }
      ],
      "destination": "/api/share-preview?kind=portal&token=:token"
    },
    {
      "source": "/shared/:token",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|Slackbot|TelegramBot|LinkedInBot|Discordbot|SkypeUriPreview|Googlebot).*"
        }
      ],
      "destination": "/api/share-preview?kind=photos&token=:token"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ],
  "functions": {
    "api/share-card.ts": {
      "includeFiles": "{node_modules/@resvg/resvg-wasm/index_bg.wasm,node_modules/harfbuzzjs/hb.wasm,api/_lib/Geist-Regular.ttf}"
    }
  },
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
